#!/usr/bin/env bash
# Install yin from a GitHub release instead of building it:
#   script/install-release            the latest release
#   script/install-release v0.1.0     a specific one
# Also works piped from the web:
#   curl -fsSL https://raw.githubusercontent.com/vincent-626/yin/main/script/install-release | bash
set -euo pipefail
repo=vincent-626/yin
tag=${1:-}
if [ -n "$tag" ]; then
  base="https://github.com/$repo/releases/download/$tag"
else
  base="https://github.com/$repo/releases/latest/download"
fi
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

curl -fsSL "$base/yin-macos-arm64.zip" -o "$work/yin-macos-arm64.zip"
curl -fsSL "$base/yin-macos-arm64.zip.sha256" -o "$work/yin-macos-arm64.zip.sha256"
(cd "$work" && shasum -a 256 -c yin-macos-arm64.zip.sha256 >/dev/null)
ditto -x -k "$work/yin-macos-arm64.zip" "$work"

# The app is ad-hoc signed, not notarized: clear the download quarantine so
# Gatekeeper lets it open.
xattr -dr com.apple.quarantine "$work/yin.app"

mkdir -p ~/Applications ~/.local/bin
rm -rf ~/Applications/yin.app
mv "$work/yin.app" ~/Applications/yin.app
cat > ~/.local/bin/yin <<'SHIM'
#!/usr/bin/env bash
# Open a repository in yin (default: the current directory).
target=$(cd "${1:-.}" && pwd)
exec ~/Applications/yin.app/Contents/MacOS/yin "$target" >/dev/null 2>&1 &
SHIM
chmod +x ~/.local/bin/yin
version=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' ~/Applications/yin.app/Contents/Info.plist)
echo "Installed yin $version to ~/Applications/yin.app"
