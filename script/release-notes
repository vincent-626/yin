#!/usr/bin/env bash
# Print CHANGELOG.md's section for a version, for its GitHub release:
#   script/release-notes 0.4.0
# Fails when the changelog has no section for it.
set -euo pipefail
version=${1#v}
notes=$(awk -v version="$version" '
  /^## / { if (found) exit; if ($2 == version) { found = 1; next } }
  found { print }
' "$(dirname "$0")/../CHANGELOG.md")
if [ -z "${notes//[[:space:]]/}" ]; then
  echo "CHANGELOG.md has no section for $version" >&2
  exit 1
fi
printf '%s\n' "$notes"
