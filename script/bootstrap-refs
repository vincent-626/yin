#!/usr/bin/env bash
# Clone read-only reference checkouts into ref/ for humans and agents to grep.
# Shallow and gitignored. Re-run to refresh.
set -euo pipefail
cd "$(dirname "$0")/.."
mkdir -p ref

clone() {
  local name=$1 url=$2
  if [ -d "ref/$name/.git" ]; then
    git -C "ref/$name" fetch --depth 1 origin HEAD && git -C "ref/$name" reset --hard FETCH_HEAD
  else
    git clone --depth 1 "$url" "ref/$name"
  fi
}

clone zed https://github.com/zed-industries/zed.git
clone gpui-component https://github.com/longbridge/gpui-component.git
